# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# MCP Server Configuration (for gateway)
MCP_MEMORY_SERVER_ARN=arn:aws:bedrock-agentcore:us-east-1:662403250828:runtime/agentcore_memory_mcp_server-R4jmV6ERZD

# QNA Agent Configuration (for MCP node caller)
QNA_AGENT_ARN=arn:aws:bedrock-agentcore:us-east-1:662403250828:runtime/agentcore_qna_agent-LuJi165oYZ

# Optional: Default Actor/Session IDs
DEFAULT_ACTOR_ID=qna-specialist-user
DEFAULT_SESSION_ID=default-session

# Optional: Gateway Configuration
GATEWAY_TIMEOUT=30.0
GATEWAY_RETRY_ATTEMPTS=3
GATEWAY_RETRY_DELAY=1.0
