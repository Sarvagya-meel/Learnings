# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here

# HuggingFace API Configuration (optional)
HF_API_KEY=your_huggingface_api_key_here

# MCP Memory Server Configuration
# Use the ARN of your deployed MCP memory server
MCP_MEMORY_SERVER_ARN=arn:aws:bedrock-agentcore:us-east-1:ACCOUNT_ID:runtime/agentcore_memory_mcp_server-XXXXX

# AWS Configuration
AWS_REGION=us-east-1

# Default Actor and Session IDs (optional)
DEFAULT_ACTOR_ID=qna-specialist-user
DEFAULT_SESSION_ID=default-session

# Database Configuration (for 04_agentcore_with_database.py)
# Supported types: postgresql, mysql, dynamodb
DB_TYPE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=qna_database
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_TABLE=faqs

# Logging Configuration
LOG_LEVEL=INFO
